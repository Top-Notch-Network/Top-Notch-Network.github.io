---
// Shared SEO head tags for the main (non-blog) pages. Blog pages use BlogLayout, which emits the same set.
import { SITE } from '../lib/blog';
interface Props { title: string; description: string; type?: string; jsonLd?: object | object[] }
const { title, description, type = 'website', jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(SITE.ogDefault, SITE.url).href;
const blocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{blocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
