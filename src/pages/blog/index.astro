---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import TagFilter from '../../components/blog/TagFilter.astro';
import RssButton from '../../components/blog/RssButton.astro';
import { getPosts, SITE } from '../../lib/blog';

const posts = await getPosts();
const [latest, ...rest] = posts;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.blogTitle,
  description: SITE.blogDescription,
  url: new URL('/blog/', SITE.url).href,
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url, logo: new URL(SITE.logo, SITE.url).href },
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: new URL(`/blog/${p.id}/`, SITE.url).href, datePublished: p.data.date.toISOString() })),
};
---
<BlogLayout title="Blog" description={SITE.blogDescription} jsonLd={jsonLd}>
  <section class="max-w-7xl mx-auto px-6 pt-16 md:pt-20 pb-10">
    <span class="text-[#c20e0e] text-xs font-black tracking-widest block mb-4">// MEDIA / BLOG</span>
    <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-[#e4e4e7] leading-tight mb-5">
      FIELD NOTES ON <br class="hidden sm:block" /><span class="text-[#c20e0e]">STEWARDSHIP</span>
    </h1>
    <p class="text-zinc-400 text-sm md:text-base normal-case tracking-normal max-w-2xl leading-relaxed">
      Practical thinking on leadership, governance and the systems that sustain service. Written for leaders who measure
      their wealth by the value they pour into those in their care.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] font-bold tracking-widest text-zinc-500">
      <RssButton />
      <span>{posts.length} {posts.length === 1 ? 'POST' : 'POSTS'}</span>
    </div>
  </section>

  {posts.length > 0 && <TagFilter posts={posts} />}

  <section class="max-w-7xl mx-auto px-6 pb-24" aria-label="Posts">
    {posts.length === 0 ? (
      <div class="border border-dashed border-[#27272a] bg-[#0d0d10] px-6 py-16 md:py-20 text-center">
        <span class="text-[#c20e0e] text-xs font-black tracking-widest block mb-4">// COMING SOON</span>
        <p class="text-2xl md:text-3xl font-black text-[#e4e4e7] mb-4">NO POSTS YET. <span class="text-[#c20e0e]">CHECK BACK SOON.</span></p>
        <p class="normal-case tracking-normal text-sm md:text-base text-zinc-400 max-w-xl mx-auto leading-relaxed mb-8">
          We're preparing our first field notes on leadership, governance and the systems that sustain service.
          Subscribe to the RSS feed to hear when they're published, or start the conversation now.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <RssButton />
          <a href="/contact" class="inline-block bg-[#c20e0e] hover:bg-[#9e0b0b] text-white font-black px-6 py-3 text-xs tracking-widest border border-[#d30000] transition">CONTACT US</a>
        </div>
      </div>
    ) : (
      <div class="flex flex-col gap-8">
        <PostCard post={latest} featured />
        {rest.length > 0 && (
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">{rest.map((p) => <PostCard post={p} />)}</div>
        )}
      </div>
    )}
  </section>
</BlogLayout>
