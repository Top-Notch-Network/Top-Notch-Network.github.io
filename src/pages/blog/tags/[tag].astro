---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import TagChip from '../../../components/blog/TagChip.astro';
import { getPosts, allTags, tagSlug } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return allTags(posts).map((t) => ({
    params: { tag: t.slug },
    props: { tag: t.tag, posts: posts.filter((p) => p.data.tags.some((x) => tagSlug(x) === t.slug)) },
  }));
}
const { tag, posts } = Astro.props;
const tags = allTags(await getPosts());
---
<BlogLayout title={`Posts tagged “${tag}”`} description={`Top-Notch Network blog posts about ${tag}.`}>
  <section class="max-w-7xl mx-auto px-6 pt-16 md:pt-20 pb-8">
    <a href="/blog/" class="text-xs font-black tracking-widest text-zinc-500 hover:text-white transition">← ALL POSTS</a>
    <h1 class="mt-6 text-3xl sm:text-5xl font-black tracking-tight text-[#e4e4e7] leading-tight">
      TOPIC: <span class="text-[#c20e0e] normal-case tracking-normal">#{tag}</span>
    </h1>
    <p class="mt-3 text-[11px] font-bold tracking-widest text-zinc-500">{posts.length} {posts.length === 1 ? 'POST' : 'POSTS'}</p>
  </section>
  <nav aria-label="Browse by topic" class="max-w-7xl mx-auto px-6 pb-10">
    <div class="border-y border-[#27272a] py-4 flex flex-wrap gap-2">
      {tags.map((t) => <TagChip tag={t.tag} count={t.count} active={t.tag === tag} />)}
    </div>
  </nav>
  <section class="max-w-7xl mx-auto px-6 pb-24 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {posts.map((p) => <PostCard post={p} />)}
  </section>
</BlogLayout>
